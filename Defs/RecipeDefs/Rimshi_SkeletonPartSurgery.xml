<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Install surgeries for skeleton parts. Not based on vanilla's install bases, which add Human-wide medicine
       ingredients: skeletons take no medicine, so each install uses a repair kit instead. The worker only offers them on
       skeletons, and the prosthetics lock leaves recipes named Rimshi_ alone. No anaesthetic: skeletons are machines. -->
  <RecipeDef Name="Rimshi_InstallSkeletonPartBase" ParentName="SurgeryFlesh" Abstract="True">
    <workerClass>RimshiSkeletons.Recipe_Rimshi_InstallSkeletonPart</workerClass>
    <workAmount>2500</workAmount>
    <anesthetize>false</anesthetize>
    <recipeUsers>
      <li>Human</li>
    </recipeUsers>
    <skillRequirements>
      <Medicine>5</Medicine>
    </skillRequirements>
  </RecipeDef>

  <RecipeDef ParentName="Rimshi_InstallSkeletonPartBase">
    <defName>Rimshi_Install_EconomyArm</defName>
    <label>install economy skeleton arm</label>
    <description>Install an economy skeleton arm.</description>
    <descriptionHyperlinks>
      <ThingDef>Rimshi_EconomyArm</ThingDef>
      <HediffDef>Rimshi_EconomyArm</HediffDef>
    </descriptionHyperlinks>
    <jobString>Installing economy skeleton arm.</jobString>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Rimshi_RepairKit</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Rimshi_EconomyArm</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Rimshi_RepairKit</li>
        <li>Rimshi_EconomyArm</li>
      </thingDefs>
    </fixedIngredientFilter>
    <appliedOnFixedBodyParts>
      <li>Shoulder</li>
    </appliedOnFixedBodyParts>
    <addsHediff>Rimshi_EconomyArm</addsHediff>
  </RecipeDef>
