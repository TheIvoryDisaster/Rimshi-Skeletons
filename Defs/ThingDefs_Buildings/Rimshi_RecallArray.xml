<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- The recall array: a rusted relay tower built around Biotech's mechband antenna (vanilla defName
       BurnoutMechlinkBooster), rewired to broadcast the old empire's recall codes. It has its own art (Matthew's tower,
       2026-11-18): one view, not rotatable, 3x5 cells with the drawing filling the footprint. It does not inherit from the
       antenna, so the array always has a thingClass even if the antenna changes. Any colonist can activate it (no mechanitor needed); it
       burns out, and a few hours later a hostile horde from the hidden recalled legion faction drops in around it as a raid. -->
  <ThingDef ParentName="BuildingBase">
    <defName>Rimshi_RecallArray</defName>
    <label>skeleton recall array</label>
    <description>A rusted relay tower raised around a mechband antenna and rewired to broadcast the old empire's recall codes. A colonist can activate it to call a dormant skeleton legion out of the dark.\n\nThe legion arrives by drop pod around the array a few hours later. It is hostile, and most of its skeletons carry corrupted protocols. Some still carry a failsafe core that shuts the frame down instead of letting it be destroyed; those can be captured, and corrupted ones reprogrammed to join the colony.\n\nThe broadcast burns out the array. Each new broadcast reaches further and wakes a larger legion.</description>
    <graphicData>
      <texPath>Rimshi/Buildings/RecallArray</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,5)</drawSize>
      <drawRotated>false</drawRotated>
      <damageData>
        <rect>(0.3,0.3,2.4,4.4)</rect>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.6</staticSunShadowHeight>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>false</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <passability>Impassable</passability>
    <disableImpassableShotOverConfigError>true</disableImpassableShotOverConfigError>
    <fillPercent>0.75</fillPercent>
    <blockWind>true</blockWind>
    <canOverlapZones>false</canOverlapZones>
    <building>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <designationCategory>Biotech</designationCategory>
    <uiOrder>2455</uiOrder>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>8000</WorkToBuild>
      <Mass>25</Mass>
      <Flammability>0.5</Flammability>
    </statBases>
    <size>(3,5)</size>
    <killedLeavings>
      <ChunkSlagSteel>3</ChunkSlagSteel>
    </killedLeavings>
    <tickerType>Normal</tickerType>
    <filthLeaving>Filth_MachineBits</filthLeaving>
    <costList>
      <Steel>120</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
      <Plasteel>25</Plasteel>
    </costList>
    <researchPrerequisites>
      <li>Rimshi_SkeletonRecall</li>
    </researchPrerequisites>
    <comps>
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Broadcast recall codes</useLabel>
        <useDuration>600</useDuration>
      </li>
      <li Class="RimshiSkeletons.CompProperties_RecallArray">
        <minDelayTicks>2500</minDelayTicks>
        <maxDelayTicks>15000</maxDelayTicks>
      </li>
    </comps>
  </ThingDef>

</Defs>
