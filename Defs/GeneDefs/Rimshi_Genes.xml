<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Skeleton genes. Values come from the original race (Rim-Skeletons, Skeleton_ race statBases), turned into
       offsets and factors against the vanilla human. See docs/design/xenotype-port.md. -->

  <GeneCategoryDef>
    <defName>Rimshi_Skeleton</defName>
    <label>skeleton</label>
    <displayPriorityInXenotype>990</displayPriorityInXenotype>
  </GeneCategoryDef>

  <GeneDef Name="Rimshi_SkeletonGeneBase" Abstract="True">
    <displayCategory>Rimshi_Skeleton</displayCategory>
    <iconColor>(0.75, 0.75, 0.75)</iconColor>
    <!-- Never rolled into genepacks (traders, quests); see GeneProofing.cs for the rest of the gene lock. -->
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
  </GeneDef>

  <!-- Looks: skeleton body (drawn by the body render patch), the six skeleton heads, no tattoos. -->
  <GeneDef ParentName="Rimshi_SkeletonGeneBase">
    <defName>Rimshi_SkeletonFrame</defName>
    <label>skeleton frame</label>
    <labelShortAdj>skeletal</labelShortAdj>
    <description>Carriers of this gene are housed in an ancient proto-mechanical frame instead of a body of flesh. Their plated torso and limbs take a male, thin or hulking build, and their heads are one of a handful of old manufacturing patterns.</description>
    <geneClass>RimshiSkeletons.Gene_SkeletonFrame</geneClass>
    <iconPath>Rimshi/Head/Mki_south</iconPath>
    <displayOrderInCategory>0</displayOrderInCategory>
    <forcedHeadTypes>
      <li>Rimshi_Head_Mki</li>
      <li>Rimshi_Head_Log</li>
      <li>Rimshi_Head_Lion</li>
      <li>Rimshi_Head_Scout</li>
      <li>Rimshi_Head_Catlon</li>
      <li>Rimshi_Head_Screamer</li>
    </forcedHeadTypes>
    <tattoosVisible>false</tattoosVisible>
    <exclusionTags>
      <li>Fur</li>
    </exclusionTags>
    <biostatCpx>1</biostatCpx>
  </GeneDef>

  <!-- Body stats: armour, heat, cold, fire, speed, carrying, dodge, pain shock, vacuum. -->
  <GeneDef ParentName="Rimshi_SkeletonGeneBase">
    <defName>Rimshi_MetalChassis</defName>
    <label>metal chassis</label>
    <labelShortAdj>plated</labelShortAdj>
    <description>Carriers of this gene have a plated metal chassis. It shrugs off blades and heat, never burns, works in any temperature and carries more than a human, but it is a little slower and a hard enough knock shuts it down sooner.</description>
    <iconPath>UI/Icons/Genes/Gene_Tough</iconPath>
    <displayOrderInCategory>10</displayOrderInCategory>
    <statOffsets>
      <ArmorRating_Blunt>0.12</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.4</ArmorRating_Sharp>
      <ArmorRating_Heat>2</ArmorRating_Heat>
      <ComfyTemperatureMin>-116</ComfyTemperatureMin>
      <ComfyTemperatureMax>224</ComfyTemperatureMax>
      <MoveSpeed>-0.35</MoveSpeed>
      <MeleeDodgeChance>0.5</MeleeDodgeChance>
      <PainShockThreshold>-0.3</PainShockThreshold>
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">1</VacuumResistance>
    </statOffsets>
    <statFactors>
      <Flammability>0</Flammability>
      <CarryingCapacity>1.2</CarryingCapacity>
    </statFactors>
    <biostatCpx>3</biostatCpx>
    <biostatMet>-3</biostatMet>
  </GeneDef>

  <!-- Marker gene: disease and chemical immunity, toxins, darkness, dulled psychic sense. The blocked thoughts and the
       immunity list are filled in at startup by SkeletonDefs, so defs from DLCs and mods that are not loaded are
       skipped instead of erroring. -->
  <GeneDef ParentName="Rimshi_SkeletonGeneBase">
    <defName>Rimshi_MechanicalNature</defName>
    <label>mechanical nature</label>
    <labelShortAdj>mechanical</labelShortAdj>
    <description>Carriers of this gene are machines. They never fall ill, cannot be poisoned, do not mind the dark, the wet or going without clothes, and feel psychic effects only faintly.</description>
    <iconPath>UI/Icons/Genes/Gene_TotalToxicityResistance</iconPath>
    <displayOrderInCategory>20</displayOrderInCategory>
    <immuneToToxGasExposure>true</immuneToToxGasExposure>
    <ignoreDarkness>true</ignoreDarkness>
    <statOffsets>
      <ToxicResistance>1</ToxicResistance>
      <ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
      <PsychicSensitivity>-0.5</PsychicSensitivity>
    </statOffsets>
    <customEffectDescriptions>
      <li>Immune to disease, infection, food poisoning, overdose and chemical damage</li>
      <li>Does not mind darkness, nakedness, wet clothes or pain</li>
    </customEffectDescriptions>
    <biostatCpx>4</biostatCpx>
    <biostatMet>-4</biostatMet>
  </GeneDef>

  <!-- Mind: steady, curious and a little cold. -->
  <GeneDef ParentName="Rimshi_SkeletonGeneBase">
    <defName>Rimshi_ArchaicMind</defName>
    <label>archaic persona</label>
    <labelShortAdj>archaic</labelShortAdj>
    <description>Carriers of this gene run an ancient persona. It rarely breaks under stress and learns quickly, but it is awkward with people and clumsy with living things like plants.</description>
    <iconPath>UI/Icons/Genes/Gene_DeadCalm</iconPath>
    <displayOrderInCategory>30</displayOrderInCategory>
    <statOffsets>
      <MentalBreakThreshold>-0.15</MentalBreakThreshold>
    </statOffsets>
    <statFactors>
      <ResearchSpeed>1.3</ResearchSpeed>
      <SocialImpact>0.5</SocialImpact>
      <PlantWorkSpeed>0.5</PlantWorkSpeed>
      <PlantHarvestYield>0.7</PlantHarvestYield>
      <MiningSpeed>0.9</MiningSpeed>
    </statFactors>
    <biostatCpx>2</biostatCpx>
  </GeneDef>

  <!-- Diet: eats only fuel (things with RimshiSkeletons.FuelExtension: chemfuel and uranium), very slowly. -->
  <GeneDef ParentName="Rimshi_SkeletonGeneBase">
    <defName>Rimshi_FuelReactor</defName>
    <label>fuel reactor</label>
    <labelShortAdj>reactor</labelShortAdj>
    <description>Carriers of this gene run on an internal reactor instead of a stomach. They burn through fuel very slowly and can eat nothing but chemfuel and uranium. Nobody else can eat those.</description>
    <geneClass>RimshiSkeletons.Gene_FuelReactor</geneClass>
    <iconPath>UI/Icons/Genes/Gene_RobustDigestion</iconPath>
    <displayOrderInCategory>40</displayOrderInCategory>
    <customEffectDescriptions>
      <li>Eats only chemfuel and uranium</li>
      <li>Hunger rate: x10%</li>
    </customEffectDescriptions>
    <modExtensions>
      <li Class="RimshiSkeletons.FuelReactorExtension">
        <hungerRateFactor>0.1</hungerRateFactor>
      </li>
    </modExtensions>
    <biostatCpx>2</biostatCpx>
    <biostatMet>3</biostatMet>
  </GeneDef>

  <!-- Genderless, asexual, sterile: the "null chromosome pattern" approach from Rim-Hivers! - Biotech (VexedTrees). -->
  <GeneDef ParentName="Rimshi_SkeletonGeneBase">
    <defName>Rimshi_NullChromosome</defName>
    <label>null chromosome pattern</label>
    <labelShortAdj>genderless</labelShortAdj>
    <description>Carriers of this gene have no sex at all. They are always asexual, cannot have children, and are never generated with family.</description>
    <geneClass>RimshiSkeletons.Gene_NullChromosome</geneClass>
    <iconPath>UI/Icons/Genes/Gene_Sterile</iconPath>
    <displayOrderInCategory>50</displayOrderInCategory>
    <forcedTraits>
      <li>
        <def>Asexual</def>
      </li>
    </forcedTraits>
    <statFactors>
      <Fertility>0</Fertility>
    </statFactors>
    <customEffectDescriptions>
      <li>Genderless</li>
    </customEffectDescriptions>
    <biostatCpx>1</biostatCpx>
    <biostatMet>1</biostatMet>
  </GeneDef>

  <!-- Plating colours. The xenotype carries steel, aged steel and rust, and Biotech picks one of them at random for
       each pawn (about two in three steel, as in the original). Plasteel and mech black are for custom xenotypes. -->
  <GeneDef Name="Rimshi_PlatingBase" ParentName="GeneSkinColorOverride" Abstract="True">
    <displayCategory>Rimshi_Skeleton</displayCategory>
    <iconPath>UI/Icons/Genes/Gene_SkinColorOverride</iconPath>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
  </GeneDef>

  <GeneDef ParentName="Rimshi_PlatingBase">
    <defName>Rimshi_Plating_Steel</defName>
    <label>steel plating</label>
    <labelShortAdj>steel</labelShortAdj>
    <description>Carriers of this gene have bare steel plating, from fresh white steel to a dull grey.</description>
    <skinColorOverride>(110, 110, 110)</skinColorOverride>
    <randomBrightnessFactor>0.12</randomBrightnessFactor>
    <displayOrderInCategory>60</displayOrderInCategory>
  </GeneDef>

  <GeneDef ParentName="Rimshi_PlatingBase">
    <defName>Rimshi_Plating_AgedSteel</defName>
    <label>aged steel plating</label>
    <labelShortAdj>aged</labelShortAdj>
    <description>Carriers of this gene have old, darkened steel plating.</description>
    <skinColorOverride>(75, 75, 75)</skinColorOverride>
    <randomBrightnessFactor>0.12</randomBrightnessFactor>
    <displayOrderInCategory>61</displayOrderInCategory>
  </GeneDef>

  <GeneDef ParentName="Rimshi_PlatingBase">
    <defName>Rimshi_Plating_Rust</defName>
    <label>rusted plating</label>
    <labelShortAdj>rusted</labelShortAdj>
    <description>Carriers of this gene have plating that has rusted over the centuries.</description>
    <skinColorOverride>(105, 87, 84)</skinColorOverride>
    <randomBrightnessFactor>0.18</randomBrightnessFactor>
    <displayOrderInCategory>62</displayOrderInCategory>
  </GeneDef>

  <GeneDef ParentName="Rimshi_PlatingBase">
    <defName>Rimshi_Plating_Plasteel</defName>
    <label>plasteel plating</label>
    <labelShortAdj>plasteel</labelShortAdj>
    <description>Carriers of this gene have rare, pale blue plasteel plating.</description>
    <skinColorOverride>(160, 178, 181)</skinColorOverride>
    <randomBrightnessFactor>0</randomBrightnessFactor>
    <displayOrderInCategory>63</displayOrderInCategory>
  </GeneDef>

  <GeneDef ParentName="Rimshi_PlatingBase">
    <defName>Rimshi_Plating_MechBlack</defName>
    <label>mech black plating</label>
    <labelShortAdj>black</labelShortAdj>
    <description>Carriers of this gene have the near-black plating of a mechanoid.</description>
    <skinColorOverride>(54, 56, 51)</skinColorOverride>
    <randomBrightnessFactor>0</randomBrightnessFactor>
    <displayOrderInCategory>64</displayOrderInCategory>
  </GeneDef>

</Defs>
