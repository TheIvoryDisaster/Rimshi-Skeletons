<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Skeleton pawn kinds, ported from Rim-Skeletons (Continued) (Skele_PawnKind_Base, _Misc, _Player). Changes: race
       Human with the Rimshi_Skeleton xenotype instead of the Skeleton_ race, defNames prefixed Rimshi_, backstory
       category Rimshi_Skeleton. The original's tribal, pirate and Empire skeleton kinds are not ported: skeletons now
       join those factions through their xenotype sets (Patches/Rimshi_FactionXenotypes.xml). -->


   <!-- Bases -->

  <PawnKindDef Name="Rimshi_SkeletonKindBase" Abstract="True">
    <race>Human</race>
    <useFactionXenotypes>false</useFactionXenotypes>
    <xenotypeSet>
      <xenotypeChances>
        <Rimshi_Skeleton>1</Rimshi_Skeleton>
      </xenotypeChances>
    </xenotypeSet>
    <defaultFactionType>Rimshi_SkeletalImperium</defaultFactionType>
    <combatPower>75</combatPower>
    <backstoryFiltersOverride>
      <li>
        <categories>
            <li>Rimshi_Skeleton</li>
        </categories>
      </li>
    </backstoryFiltersOverride>
    <chemicalAddictionChance>0</chemicalAddictionChance>
    <combatEnhancingDrugsChance>0</combatEnhancingDrugsChance>
    <backstoryCryptosleepCommonality>0</backstoryCryptosleepCommonality>
    <apparelColor>(139,122,109)</apparelColor>
    <apparelAllowHeadgearChance>0.3</apparelAllowHeadgearChance>
    <!-- No packed meals (the original carried 2.55 nutrition): skeletons cannot eat them. -->
    <invNutrition>0</invNutrition>
    <weaponMoney>0</weaponMoney>
    <apparelTags>
      <li>IndustrialBasic</li>
    </apparelTags>
    <!-- No techHediffs on any kind: skeletons get no prosthetics or implants (Skeleton/ProstheticsLock.cs skips them for any kind). -->
    <initialWillRange>10~19</initialWillRange>
    <initialResistanceRange>20~37</initialResistanceRange>
  </PawnKindDef>

   <!-- Skeletons -->

  <PawnKindDef ParentName="Rimshi_SkeletonKindBase">
    <defName>Rimshi_Villager</defName>
    <label>skeleton</label>
    <labelPlural>skeletons</labelPlural>
    <gearHealthRange>0.2~2.0</gearHealthRange>
    <weaponTags>
      <li>Gun</li>
      <li>MedievalMeleeBasic</li>
    </weaponTags>
    <weaponMoney>250~300</weaponMoney>
    <backstoryCryptosleepCommonality>0</backstoryCryptosleepCommonality>
  </PawnKindDef>

  <PawnKindDef ParentName="Rimshi_SkeletonKindBase" Name="Rimshi_FighterBase" Abstract="True">
    <biocodeWeaponChance>0.2</biocodeWeaponChance>
    <initialWillRange>2~4</initialWillRange>
  </PawnKindDef>

  <PawnKindDef ParentName="Rimshi_FighterBase" Name="Rimshi_GunnerBase" Abstract="True">
