<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Same setup as Tithe. No NuGet packages locally: everything is referenced from the local RimWorld install and the
    Harmony workshop mod. Two game versions build from the same source, chosen with -p:RimWorldVersion (default 1.6):
      1.6  .NET Framework 4.7.2 + Unity, from RimWorldWin64_Data\Managed (which stands in for the framework reference assemblies)
      1.7  .NET 10 on the Waylith engine, from the game folder itself; Unity's API comes from UnityStubs.dll
    Each writes its own <version>\Assemblies\RimshiSkeletons.dll, which LoadFolders.xml picks per game version.
  -->

  <PropertyGroup>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
    <TargetFramework Condition="'$(RimWorldVersion)' == '1.7'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(RimWorldVersion)' != '1.7'">net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RimshiSkeletons</RootNamespace>
    <AssemblyName>RimshiSkeletons</AssemblyName>
    <OutputPath>..\..\$(RimWorldVersion)\Assemblies\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Default paths assume this repo lives at RimWorld\Mods\Rimshi-Skeletons in a Steam install. Override with -p:Name=Path. -->
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(MSBuildProjectDirectory)\..\..\..\..</RimWorldDir>
    <RimWorldManaged Condition="'$(RimWorldManaged)' == '' And '$(RimWorldVersion)' == '1.7'">$(RimWorldDir)</RimWorldManaged>
    <RimWorldManaged Condition="'$(RimWorldManaged)' == ''">$(RimWorldDir)\RimWorldWin64_Data\Managed</RimWorldManaged>
    <!-- The Harmony mod keeps one folder per game version (it dropped its old Current folder in October 2026); older copies may still have Current. -->
    <HarmonyMod>$(MSBuildProjectDirectory)\..\..\..\..\..\..\workshop\content\294100\2009463077</HarmonyMod>
    <HarmonyDir Condition="'$(HarmonyDir)' == '' And Exists('$(HarmonyMod)\$(RimWorldVersion)\Assemblies\0Harmony.dll')">$(HarmonyMod)\$(RimWorldVersion)\Assemblies</HarmonyDir>
    <HarmonyDir Condition="'$(HarmonyDir)' == ''">$(HarmonyMod)\Current\Assemblies</HarmonyDir>

    <!-- Set by the GitHub Actions build (see .github/workflows/build.yml); a local build leaves them empty. -->
    <RimshiCI Condition="'$(RimshiCI)' == ''">false</RimshiCI>
    <RimshiVersion Condition="'$(RimshiVersion)' == ''">dev</RimshiVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RimshiCI)' != 'true' And '$(RimWorldVersion)' != '1.7'">
    <FrameworkPathOverride>$(RimWorldManaged)</FrameworkPathOverride>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>

  <!--
    GitHub Actions has no RimWorld install, so it compiles against the community reference packages instead
    (Krafs.Rimworld.Ref for the game and Unity, Lib.Harmony.Ref for Harmony). Local builds never use these.
  -->
  <ItemGroup Condition="'$(RimshiCI)' == 'true'">
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" />
    <PackageReference Include="Lib.Harmony.Ref" Version="2.4.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(RimshiCI)' != 'true'">
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- 1.7: the game redirects every UnityEngine* reference to UnityStubs at load time, so compile against it directly. -->
  <ItemGroup Condition="'$(RimshiCI)' != 'true' And '$(RimWorldVersion)' == '1.7'">
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldManaged)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Some game signatures use engine types directly (Tithe hit this with Graphics.DrawMesh). -->
    <Reference Include="Waylith">
      <HintPath>$(RimWorldManaged)\Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(RimshiCI)' != 'true' And '$(RimWorldVersion)' != '1.7'">
    <!-- Unity's modules are compiled against netstandard 2.1; the game ships the facade. -->
    <Reference Include="netstandard">
      <HintPath>$(RimWorldManaged)\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RimWorldManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RimWorldManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Local builds: stop with a clear message instead of a page of "type or namespace not found" errors. -->
  <Target Name="RimshiCheckReferences" BeforeTargets="ResolveAssemblyReferences" Condition="'$(RimshiCI)' != 'true'">
    <Error Condition="!Exists('$(HarmonyDir)\0Harmony.dll')"
           Text="0Harmony.dll not found in $(HarmonyDir). Subscribe to Harmony on the Workshop, or build with -p:HarmonyDir=&lt;folder holding 0Harmony.dll&gt;." />
    <Error Condition="!Exists('$(RimWorldManaged)\Assembly-CSharp.dll')"
           Text="Assembly-CSharp.dll not found in $(RimWorldManaged). Keep the repo at RimWorld\Mods\Rimshi-Skeletons, or build with -p:RimWorldManaged=&lt;folder holding Assembly-CSharp.dll&gt; (RimWorldWin64_Data\Managed on 1.6, the game folder on 1.7)." />
  </Target>

  <!-- The mod ships only its own DLL. Without this, a local build copies the game's mscorlib and System*.dll (pulled in
       through FrameworkPathOverride) into 1.6\Assemblies, where RimWorld would try to load them as mod assemblies. -->
  <Target Name="RimshiNoCopyLocal" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
    </ItemGroup>
  </Target>

  <!--
    Build stamp (as in Tithe). Every local build adds 1 to BuildNumber.txt next to this file (git-ignored, so it is
    per machine) and writes obj\BuildInfo.g.cs with that number, the machine name and the time. The game logs it at
    startup ("[Rimshi][T] build"). The GitHub Actions build passes RimshiVersion (e.g. "3" on main,
    "3-my-branch.20261010.0512" on a branch) and RimshiBuildNumberOverride (the workflow run number) instead; local
    builds report version "dev".
  -->
  <Target Name="RimshiStampBuild" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <RimshiBuildNumberFile>$(MSBuildProjectDirectory)\BuildNumber.txt</RimshiBuildNumberFile>
      <RimshiBuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</RimshiBuildInfoFile>
    </PropertyGroup>
    <ReadLinesFromFile File="$(RimshiBuildNumberFile)" Condition="Exists('$(RimshiBuildNumberFile)')">
      <Output TaskParameter="Lines" PropertyName="RimshiLastBuild" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <RimshiLastBuild Condition="'$(RimshiLastBuild)' == ''">0</RimshiLastBuild>
      <RimshiBuildNumber>$([MSBuild]::Add($(RimshiLastBuild.Trim()), 1))</RimshiBuildNumber>
      <RimshiBuiltBy>$([System.Environment]::MachineName) $([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mmZ"))</RimshiBuiltBy>
    </PropertyGroup>
    <PropertyGroup Condition="'$(RimshiBuildNumberOverride)' != ''">
      <RimshiBuildNumber>$(RimshiBuildNumberOverride)</RimshiBuildNumber>
    </PropertyGroup>
    <WriteLinesToFile File="$(RimshiBuildNumberFile)" Lines="$(RimshiBuildNumber)" Overwrite="true" Condition="'$(RimshiBuildNumberOverride)' == ''" />
    <WriteLinesToFile File="$(RimshiBuildInfoFile)" Overwrite="true"
      Lines="// Generated by the RimshiStampBuild target in RimshiSkeletons.csproj. Do not edit.;namespace RimshiSkeletons { public static class BuildInfo { public const int Number = $(RimshiBuildNumber)%3B public const string Version = &quot;$(RimshiVersion)&quot;%3B public const string BuiltBy = &quot;$(RimshiBuiltBy)&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(RimshiBuildInfoFile)" />
    </ItemGroup>
  </Target>

</Project>
