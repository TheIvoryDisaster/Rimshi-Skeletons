<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- The recall array is built from Biotech's mechband antenna (the building that calls the war queen). Naming the
       antenna lets Defs/ThingDefs_Buildings/Rimshi_RecallArray.xml inherit its graphic, size and build settings; the
       array replaces the antenna's comps, cost, research and text. Biotech is a hard dependency, so the antenna is
       always there; startup logs "horde | array graphic" either way. -->

  <Operation Class="PatchOperationAttributeAdd">
    <xpath>Defs/ThingDef[defName="MechbandAntenna"]</xpath>
    <attribute>Name</attribute>
    <value>Rimshi_MechbandAntennaParent</value>
  </Operation>

</Patch>
