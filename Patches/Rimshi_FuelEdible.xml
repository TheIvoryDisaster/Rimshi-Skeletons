<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Skeletons eat chemfuel and uranium (as in the original's EdibleChemfuelUranium_Patch). Each item:
       1. tagged with RimshiSkeletons.FuelExtension, which the diet patch reads (only skeletons may eat tagged things,
          and skeletons may eat nothing else);
       2. given Nutrition and an ingestible block, each only if the item does not have one already (another mod may
          have made it edible). Each item is its own sequence so one failing test never skips the other item. -->

  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ThingDef[defName="Chemfuel"]</xpath>
    <value>
      <li Class="RimshiSkeletons.FuelExtension" />
    </value>
  </Operation>

  <Operation Class="PatchOperationSequence">
    <success>Always</success>
    <operations>
      <li Class="PatchOperationTest">
        <xpath>Defs/ThingDef[defName="Chemfuel"]/statBases/Nutrition</xpath>
        <success>Invert</success>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Chemfuel"]/statBases</xpath>
        <value>
          <Nutrition>0.08</Nutrition>
        </value>
      </li>
    </operations>
  </Operation>

  <Operation Class="PatchOperationSequence">
    <success>Always</success>
    <operations>
      <li Class="PatchOperationTest">
        <xpath>Defs/ThingDef[defName="Chemfuel"]/ingestible</xpath>
        <success>Invert</success>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Chemfuel"]</xpath>
        <value>
          <socialPropernessMatters>true</socialPropernessMatters>
          <ingestible>
            <foodType>Fluid</foodType>
            <maxNumToIngestAtOnce>10</maxNumToIngestAtOnce>
            <preferability>MealLavish</preferability>
            <ingestSound>Recipe_Cremate</ingestSound>
            <ingestCommandString>Fuel reactor with {0}</ingestCommandString>
            <ingestReportString>Fueling reactor with {0}.</ingestReportString>
            <optimalityOffsetHumanlikes>16</optimalityOffsetHumanlikes>
          </ingestible>
        </value>
      </li>
    </operations>
  </Operation>

  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ThingDef[defName="Uranium"]</xpath>
    <value>
      <li Class="RimshiSkeletons.FuelExtension" />
    </value>
  </Operation>

  <Operation Class="PatchOperationSequence">
    <success>Always</success>
    <operations>
      <li Class="PatchOperationTest">
        <xpath>Defs/ThingDef[defName="Uranium"]/statBases/Nutrition</xpath>
        <success>Invert</success>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Uranium"]/statBases</xpath>
        <value>
          <Nutrition>0.5</Nutrition>
        </value>
      </li>
    </operations>
  </Operation>

  <Operation Class="PatchOperationSequence">
    <success>Always</success>
    <operations>
      <li Class="PatchOperationTest">
        <xpath>Defs/ThingDef[defName="Uranium"]/ingestible</xpath>
        <success>Invert</success>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Uranium"]</xpath>
        <value>
          <socialPropernessMatters>true</socialPropernessMatters>
          <ingestible>
            <foodType>Fluid</foodType>
            <maxNumToIngestAtOnce>5</maxNumToIngestAtOnce>
            <preferability>MealLavish</preferability>
            <ingestSound>Recipe_Cremate</ingestSound>
            <ingestCommandString>Fuel reactor with {0}</ingestCommandString>
            <ingestReportString>Fueling reactor with {0}.</ingestReportString>
            <optimalityOffsetHumanlikes>16</optimalityOffsetHumanlikes>
          </ingestible>
        </value>
      </li>
    </operations>
  </Operation>

</Patch>
