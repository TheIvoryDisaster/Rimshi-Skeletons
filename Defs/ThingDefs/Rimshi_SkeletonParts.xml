<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Skeleton parts (docs/design/skeleton-parts.md): limbs from Kenshi's robot limbs in five tiers, plus senses and the
       AI core. Made at the skeleton workbench from the skeleton intermediates, Crafting 11. Installed only on skeletons
       (Recipe_Rimshi_InstallSkeletonPart). Placeholder art: vanilla's body part item recoloured brown with grey trim. Never burns.
       Work amounts are in ticks: the game shows them divided by 60 (3000 shows as 50). -->
  <ThingDef Name="Rimshi_SkeletonPartBase" ParentName="BodyPartBase" Abstract="True">
    <techLevel>Industrial</techLevel>
    <thingCategories>
      <li>BodyPartsProsthetic</li>
    </thingCategories>
    <graphicData>
      <texPath>Rimshi/Items/Placeholder_Part</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.80</drawSize>
    </graphicData>
    <statBases>
      <Flammability>0</Flammability>
      <DeteriorationRate>0.5</DeteriorationRate>
    </statBases>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <unfinishedThingDef>UnfinishedHealthItemBionic</unfinishedThingDef>
      <skillRequirements>
        <Crafting>11</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>Rimshi_SkeletonWorkbench</li>
      </recipeUsers>
      <displayPriority>200</displayPriority>
    </recipeMaker>
  </ThingDef>

  <ThingDef ParentName="Rimshi_SkeletonPartBase">
    <defName>Rimshi_EconomyArm</defName>
    <label>economy skeleton arm</label>
    <description>A replacement arm for a skeleton. A cheap, light-duty replacement built from the fewest parts that will do. It is weaker and clumsier than the original. Only fits a skeleton.</description>
    <descriptionHyperlinks>
      <HediffDef>Rimshi_EconomyArm</HediffDef>
    </descriptionHyperlinks>
    <costList>
      <Rimshi_Motor>1</Rimshi_Motor>
      <Rimshi_RoboticComponent>1</Rimshi_RoboticComponent>
      <Steel>20</Steel>
    </costList>
    <statBases>
      <WorkToMake>3000</WorkToMake>
      <Mass>5</Mass>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>Rimshi_SkeletonFabrication</researchPrerequisite>
    </recipeMaker>
  </ThingDef>
