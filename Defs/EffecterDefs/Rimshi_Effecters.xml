<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Hit effect on a skeleton: vanilla Damage_HitFlesh (the red spray when flesh is hit) recoloured to black oil.
       SkeletonBlood.cs plays it instead of the flesh one. -->
  <EffecterDef>
    <defName>Rimshi_Damage_HitAncientOil</defName>
    <children>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <positionRadius>0.4</positionRadius>
        <fleckDef>AirPuff</fleckDef>
        <burstCount>4~5</burstCount>
        <speed>0.4~0.8</speed>
        <scale>1.0~1.1</scale>
        <color>(22, 20, 18)</color>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <positionRadius>0.1</positionRadius>
        <fleckDef>BloodSplash</fleckDef>
        <burstCount>2~3</burstCount>
        <scale>1.1~1.4</scale>
        <color>(30, 27, 24)</color>
        <spawnLocType>OnSource</spawnLocType>
      </li>
      <li>
        <subEffecterClass>SubEffecter_SprayerTriggered</subEffecterClass>
        <positionRadius>0.0</positionRadius>
        <fleckDef>BodyImpact</fleckDef>
        <burstCount>1</burstCount>
        <scale>0.4</scale>
        <color>(200, 200, 200, 60)</color>
        <spawnLocType>OnSource</spawnLocType>
      </li>
    </children>
  </EffecterDef>

</Defs>
