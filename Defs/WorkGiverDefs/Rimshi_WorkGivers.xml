<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <WorkGiverDef>
    <defName>Rimshi_WardenReprogram</defName>
    <label>reprogram corrupted skeletons</label>
    <giverClass>RimshiSkeletons.WorkGiver_Warden_Reprogram</giverClass>
    <workType>Warden</workType>
    <verb>reprogram</verb>
    <gerund>reprogramming</gerund>
    <priorityInType>55</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <!-- Repairing skeletons is the first Smith job (above making weapons at 115) and uses Crafting, as Matthew decided
       (docs/design/kenshi-lore-and-repair.md). -->
  <WorkGiverDef>
    <defName>Rimshi_RepairSkeleton</defName>
    <label>repair skeletons</label>
    <giverClass>RimshiSkeletons.WorkGiver_Rimshi_RepairSkeleton</giverClass>
    <workType>Smithing</workType>
    <verb>repair</verb>
    <gerund>repairing</gerund>
    <priorityInType>125</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <!-- Tuning a cable fissure is research work (Matthew: "250 research work"), done as a bill at the fissure. -->
  <WorkGiverDef>
    <defName>Rimshi_TuneCableFissure</defName>
    <label>tune cable fissures</label>
    <giverClass>RimshiSkeletons.WorkGiver_Rimshi_TuneFissure</giverClass>
    <workType>Research</workType>
    <verb>tune</verb>
    <gerund>tuning</gerund>
    <priorityInType>110</priorityInType>
    <fixedBillGiverDefs>
      <li>Rimshi_CableFissure</li>
    </fixedBillGiverDefs>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
    <prioritizeSustains>true</prioritizeSustains>
  </WorkGiverDef>

</Defs>
