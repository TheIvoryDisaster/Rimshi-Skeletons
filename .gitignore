# Build intermediates
Source/**/bin/
Source/**/obj/

# Build output (rebuild with build.ps1; the GitHub Actions release zip carries the DLL)
1.6/Assemblies/
1.7/Assemblies/

# Per-machine build counter, bumped by every local build (kept out of git so pulls never conflict)
Source/**/BuildNumber.txt

# Logs
*.log

# Test log reader state (per machine)
tools/test_state.json

# IDEs
.vs/
.idea/
.vscode/
*.user
*.suo
*.DotSettings.user

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# Python caches
__pycache__/
