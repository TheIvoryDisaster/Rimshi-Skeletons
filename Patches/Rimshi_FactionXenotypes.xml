<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Skeletons are very rare among outlanders, pirates, tribes and the Empire. The original injected skeleton pawn
       kinds into those factions' pawn groups (FactionRedistribute_Patch); here each faction's xenotype set gets the
       skeleton xenotype instead, so every kind in the faction can roll one, at about the original's odds (its kinds
       had roughly 1% of each group's weight, tribes about half that). Each patch first adds an empty xenotype set
       where the faction has none. -->

  <Operation Class="PatchOperationSequence">
    <success>Always</success>
    <operations>
      <li Class="PatchOperationConditional">
        <xpath>Defs/FactionDef[@Name="OutlanderFactionBase"]/xenotypeSet/xenotypeChances</xpath>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/FactionDef[@Name="OutlanderFactionBase"]</xpath>
          <value>
            <xenotypeSet><xenotypeChances /></xenotypeSet>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/FactionDef[@Name="OutlanderFactionBase"]/xenotypeSet/xenotypeChances</xpath>
        <value>
          <Rimshi_Skeleton>0.01</Rimshi_Skeleton>
        </value>
      </li>
    </operations>
  </Operation>

  <Operation Class="PatchOperationSequence">
    <success>Always</success>
    <operations>
      <li Class="PatchOperationConditional">
        <xpath>Defs/FactionDef[@Name="PirateBandBase"]/xenotypeSet/xenotypeChances</xpath>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/FactionDef[@Name="PirateBandBase"]</xpath>
          <value>
            <xenotypeSet><xenotypeChances /></xenotypeSet>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/FactionDef[@Name="PirateBandBase"]/xenotypeSet/xenotypeChances</xpath>
        <value>
          <Rimshi_Skeleton>0.01</Rimshi_Skeleton>
        </value>
      </li>
    </operations>
  </Operation>

  <Operation Class="PatchOperationSequence">
    <success>Always</success>
    <operations>
      <li Class="PatchOperationConditional">
        <xpath>Defs/FactionDef[@Name="TribeBase"]/xenotypeSet/xenotypeChances</xpath>
        <nomatch Class="PatchOperationAdd">
          <xpath>Defs/FactionDef[@Name="TribeBase"]</xpath>
          <value>
            <xenotypeSet><xenotypeChances /></xenotypeSet>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/FactionDef[@Name="TribeBase"]/xenotypeSet/xenotypeChances</xpath>
        <value>
          <Rimshi_Skeleton>0.005</Rimshi_Skeleton>
        </value>
      </li>
    </operations>
  </Operation>

  <!-- Royalty: skeletons in the Empire, and the Empire not a permanent enemy of the skeleton player faction (it is not
       one of the vanilla player factions either). Matched by mod name, so nothing happens without Royalty. -->
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Royalty</li>
    </mods>
    <match Class="PatchOperationSequence">
      <success>Always</success>
      <operations>
        <li Class="PatchOperationConditional">
          <xpath>Defs/FactionDef[defName="Empire"]/xenotypeSet/xenotypeChances</xpath>
          <nomatch Class="PatchOperationAdd">
            <xpath>Defs/FactionDef[defName="Empire"]</xpath>
            <value>
              <xenotypeSet><xenotypeChances /></xenotypeSet>
            </value>
          </nomatch>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/FactionDef[defName="Empire"]/xenotypeSet/xenotypeChances</xpath>
          <value>
            <Rimshi_Skeleton>0.01</Rimshi_Skeleton>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/FactionDef[defName="Empire"]/permanentEnemyToEveryoneExcept</xpath>
          <value>
            <li>Rimshi_PlayerSkeletons</li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>

</Patch>
