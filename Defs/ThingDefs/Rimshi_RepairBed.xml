<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- The skeleton repair bed (docs/design/kenshi-lore-and-repair.md, section 3). Built like the hospital bed, with
       its own art (a Kenshi-style repair machine). Only skeletons can use it
       (Patch_RepairBedOnlySkeletons); while powered, CompRimshi_RepairBed mends whoever lies in it. Medical by default,
       and its tend quality offset (0.12) beats the hospital bed's (0.10), so vanilla's patient bed search picks it first. -->
  <ThingDef ParentName="BedWithQualityBase">
    <defName>Rimshi_SkeletonRepairBed</defName>
    <label>skeleton repair bed</label>
    <description>A powered cradle of clamps, tool arms and diagnostic cables, run by an AI persona core, of the kind the old empire kept for its skeletons. A skeleton lying in it is slowly repaired back to full health, scars and all, though it cannot rebuild a lost part. It is also where skeletons run a CPU soft cycle, which draws heavily on the power grid while it runs. Only skeletons can use it.</description>
    <graphicData>
      <!-- 256x256 like the vanilla hospital bed: the 1x2 bed centred, sides transparent. West is east mirrored.
           Drawn 20% larger than the hospital bed's (2,2) at Matthew's ask, so it overhangs its cells a little. -->
      <texPath>Rimshi/Buildings/RepairBed</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(2.4,2.4)</drawSize>
    </graphicData>
    <castEdgeShadows>True</castEdgeShadows>
    <tickerType>Rare</tickerType>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>9000</WorkToBuild>
      <Mass>60</Mass>
      <Flammability>0</Flammability>
      <Beauty>0</Beauty>
      <BedRestEffectiveness>1</BedRestEffectiveness>
      <Comfort>0.5</Comfort>
      <MedicalTendQualityOffset>0.12</MedicalTendQualityOffset>
      <SurgerySuccessChanceFactor>1.1</SurgerySuccessChanceFactor>
    </statBases>
    <comps>
      <!-- Standby draw; CompRimshi_RepairBed sets the live draw each rare tick: + repairWatts while repairing, + skill
           levels x cycleWattsPerSkillLevel for each skeleton soft cycling (SoftCycle.cs). -->
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>50</basePowerConsumption>
      </li>
      <li Class="CompProperties_Flickable"/>
      <li Class="RimshiSkeletons.CompProperties_Rimshi_RepairBed">
        <repairPerDay>40</repairPerDay>
        <repairsScars>true</repairsScars>
        <standbyWatts>50</standbyWatts>
        <repairWatts>400</repairWatts>
        <cycleWattsPerSkillLevel>15</cycleWattsPerSkillLevel>
      </li>
      <!-- Vanilla BedBase gives every bed PlaceWorker_ShowFacilitiesConnections, which throws in the build menu unless the
           bed links to facilities. The hospital bed's list: a vitals monitor works with this bed too. -->
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>VitalsMonitor</li>
          <li>EndTable</li>
          <li>Dresser</li>
        </linkableFacilities>
      </li>
    </comps>
    <size>(1,2)</size>
    <costList>
      <AIPersonaCore>1</AIPersonaCore>
      <Plasteel>50</Plasteel>
      <Steel>80</Steel>
      <ComponentIndustrial>6</ComponentIndustrial>
    </costList>
    <!-- All of it back on deconstruct, so the single AI persona core is never rounded away. -->
    <resourcesFractionWhenDeconstructed>1</resourcesFractionWhenDeconstructed>
    <building>
      <bed_showSleeperBody>True</bed_showSleeperBody>
      <bed_healPerDay>0</bed_healPerDay>
      <bed_defaultMedical>true</bed_defaultMedical>
      <buildingSizeCategory>Small</buildingSizeCategory>
    </building>
    <fillPercent>0.4</fillPercent>
    <pathCost>42</pathCost>
    <staticSunShadowHeight>0.17</staticSunShadowHeight>
    <researchPrerequisites>
      <li>Rimshi_SkeletonRepairBeds</li>
    </researchPrerequisites>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <techLevel>Industrial</techLevel>
    <uiIconScale>0.90</uiIconScale>
  </ThingDef>

</Defs>
